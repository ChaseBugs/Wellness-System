NODE_ENV=development
PORT=4500
API_PREFIX=/api/v1

# PostgreSQL 14+ (gen_random_uuid is built in). `npm run db:local` starts one on this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wellness_platform
DB_POOL_MAX=20
AUTO_MIGRATE=true

CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JSON_LIMIT=1mb

# Required in production. Access tokens are short-lived; refresh tokens rotate.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# The "dev" purchase store trusts client payloads, so it is always disabled in production.
DEV_STORE_ENABLED=true

# Background jobs registered by modules (reminder delivery, scheduled campaigns). With several
# instances, enable it on one of them.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# "log" records pushes without sending them (never allowed in production); "fcm" is not wired in yet.
PUSH_PROVIDER=log
PUSH_REMINDER_GRACE_MINUTES=30

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@wellness.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_SAMPLE_CONTENT=true
