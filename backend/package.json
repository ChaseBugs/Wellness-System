{
  "name": "wellness-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular Express + TypeScript + PostgreSQL backend shared by every app in the Wellness Ecosystem",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:local": "tsx src/scripts/local-postgres.ts",
    "smoke": "tsx src/scripts/smoke-test.ts",
    "db:local:stop": "tsx src/scripts/local-postgres.ts stop",
    "import:legacy:foodvisor": "tsx src/scripts/import-legacy-foodvisor.ts",
    "import:legacy:talentbaby": "tsx src/scripts/import-legacy-talentbaby.ts",
    "import:legacy:height": "tsx src/scripts/import-legacy-height.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "javascript-lp-solver": "^1.0.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
